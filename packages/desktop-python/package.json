{
  "name": "@e2b/desktop-python",
  "private": true,
  "version": "2.7.2",
  "scripts": {
    "test": "uv run pytest -n 4 --verbose -x",
    "postVersion": "uv version --frozen $(pnpm pkg get version --workspaces=false | tr -d \\\")",
    "lock": "uv lock",
    "postPublish": "sh ../../.github/scripts/publish_python_package.sh",
    "typecheck": "uv run make typecheck",
    "lint": "uv run make lint",
    "format": "uv run make format"
  }
}
