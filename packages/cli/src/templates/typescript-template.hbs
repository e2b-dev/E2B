import { Template } from 'e2b'

export const template = Template()
{{#if fromImage}}
  .fromImage('{{{escapeQuotes fromImage}}}')
{{/if}}
{{#each steps}}
{{#eq type "WORKDIR"}}
  .setWorkdir('{{{escapeQuotes args.[0]}}}')
{{/eq}}
{{#eq type "USER"}}
  .setUser('{{{escapeQuotes args.[0]}}}')
{{/eq}}
{{#eq type "ENV"}}
  .setEnvs({
{{#each envVars}}
    '{{{escapeQuotes @key}}}': '{{{escapeQuotes this}}}',
{{/each}}
  })
{{/eq}}
{{#eq type "RUN"}}
  .runCmd('{{{escapeQuotes args.[0]}}}')
{{/eq}}
{{#eq type "COPY"}}
  .copy('{{{escapeQuotes src}}}', '{{{escapeQuotes dest}}}')
{{/eq}}
{{/each}}
{{#if startCmd}}
{{#if readyCmd}}
  .setStartCmd('sudo {{{escapeQuotes startCmd}}}', '{{{escapeQuotes readyCmd}}}')
{{/if}}
{{else if readyCmd}}
  .setReadyCmd('sudo {{{escapeQuotes readyCmd}}}')
{{/if}}
