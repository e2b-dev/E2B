from e2b import {{#if isAsync}}AsyncTemplate{{else}}Template{{/if}}

template = (
    {{#if isAsync}}AsyncTemplate{{else}}Template{{/if}}()
{{#if fromImage}}
    .from_image("{{{escapeDoubleQuotes fromImage}}}")
{{/if}}
{{#each steps}}
{{#eq type "WORKDIR"}}
    .set_workdir("{{{escapeDoubleQuotes args.[0]}}}")
{{/eq}}
{{#eq type "USER"}}
    .set_user("{{{escapeDoubleQuotes args.[0]}}}")
{{/eq}}
{{#eq type "ENV"}}
    .set_envs({
{{#each envVars}}
        "{{{escapeDoubleQuotes @key}}}": "{{{escapeDoubleQuotes this}}}",
{{/each}}
    })
{{/eq}}
{{#eq type "RUN"}}
    .run_cmd("{{{escapeDoubleQuotes args.[0]}}}")
{{/eq}}
{{#eq type "COPY"}}
    .copy("{{{escapeDoubleQuotes src}}}", "{{{escapeDoubleQuotes dest}}}")
{{/eq}}
{{/each}}
{{#if startCmd}}
{{#if readyCmd}}
    .set_start_cmd("sudo {{{escapeDoubleQuotes startCmd}}}", "{{{escapeDoubleQuotes readyCmd}}}")
{{/if}}
{{else if readyCmd}}
    .set_ready_cmd("sudo {{{escapeDoubleQuotes readyCmd}}}")
{{/if}}
)
