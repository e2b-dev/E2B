{
  "compilerOptions": {
    "outDir": "dist",
    "target": "es2022",
    "module": "esnext",
    "lib": [
      "dom",
      "es2022"
    ],
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    // TypeScript 7's native tsc does not auto-include node_modules/@types, so
    // the Node globals the SDK uses (process, Buffer, `node:*` modules) have to
    // be requested explicitly.
    "types": [
      "node"
    ],
  },
  "include": [
    "src",
    // Type fixtures for the generated MCP types, which `skipLibCheck` would
    // otherwise leave unchecked. Only this directory, so the rest of the test
    // suite stays out of `tsc`.
    "tests/types"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "tsdown.config.ts"
  ]
}
